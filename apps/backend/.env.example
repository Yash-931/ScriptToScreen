# Copy this file to apps/backend/.env and fill in your values.
# The .env file is git-ignored. Never commit real secrets.

# PostgreSQL connection string, used by the backend and by Prisma
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/scripttoscreen

# Secret used to sign login tokens. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Google Cloud project ID for Vertex AI (Gemini and Veo) and Cloud Storage
GCP_PROJECT=your-gcp-project-id

# Path to the service account JSON key, relative to apps/backend
GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# Cloud Storage bucket for reference images, frames and videos
IMAGE_BUCKET=your-bucket-name
